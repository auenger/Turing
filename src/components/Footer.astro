---
import LogoMark from './LogoMark.astro';
const base = import.meta.env.BASE_URL;
const publicAsset = (path: string) => `${base.replace(/\/$/, '')}/${path}`;
const year = new Date().getFullYear();

const groups = [
  {
    title: '产品',
    links: [
      { href: '#team-transformation', label: '研发团队转型与陪跑培训' },
      { href: '#agent-delivery', label: 'Agent 落地' },
      { href: '#expert-ecosystem', label: '业务专家 Agent 生态' },
      { href: 'https://silieco.com/', label: 'SiliEco Agent Work OS', external: true },
    ],
  },
  {
    title: '方案',
    links: [
      { href: '#concept', label: 'Agent 特区' },
      { href: '#how', label: '运行机制' },
      { href: '#capability', label: 'AI Coding Agent' },
      { href: '#capability', label: '工业 Agent' },
    ],
  },
  {
    title: '案例',
    links: [
      { href: '#case-kreditz', label: 'Kreditz' },
      { href: '#case-tianjin', label: '天津合众' },
      { href: '#case-thermal', label: '热仿真' },
      { href: '#case-training', label: '制造业研发转型' },
      { href: '#case-equipment', label: '设备对接流程' },
      { href: '#case-public', label: '公共安全研判' },
      { href: '#case-product-team', label: '研发与产品协作' },
      { href: '#case-agent-platform', label: '员工服务 Agent 平台' },
    ],
  },
  {
    title: '公司',
    links: [
      { href: '#team', label: '团队' },
      { href: 'https://www.agentszone.ai/', label: 'Agent 特区社区', external: true },
      { href: '#engagement', label: '交付与启动' },
      { href: '#engagement', label: '预约工作会议' },
    ],
  },
];
---

<footer class="border-t border-line-soft bg-canvas">
  <div class="container-wide py-14 md:py-20">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr_1fr]">
      <div>
        <div class="flex w-[132px] flex-col items-center gap-2" role="img" aria-label="硅基源流 SiliRoot">
          <LogoMark class="w-[104px]" />
          <img src={publicAsset('siliroot-wordmark.svg')} alt="" class="brand-logo w-[132px]" width="132" height="47" loading="lazy" />
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-sub">
        苏州硅基源流人工智能。以 Agent 特区承接 AI 战略，把试点放进有边界的真实工作。
        </p>
      </div>

      {
        groups.map((g) => (
          <div>
            <h4 class="text-[12px] font-semibold uppercase tracking-wider text-faint">
              {g.title}
            </h4>
            <ul class="mt-4 space-y-2.5 text-sm text-sub">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noreferrer' : undefined} class="transition-colors hover:text-ink">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line-soft pt-6 text-xs text-faint md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} 苏州硅基源流人工智能</p>
      <div class="flex items-center gap-5 md:justify-end">
        <a href={publicAsset('logo-lab.html')} class="transition-colors hover:text-ink">Logo 设计</a>
        <span>苏州</span>
      </div>
    </div>
  </div>
</footer>

<style>
  :global(html[data-theme="dark"]) .brand-logo { filter: invert(1); }
</style>
